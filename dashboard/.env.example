# Controller reached by the Vite development proxy (REST and WebSocket).
# Change this to the Controller host for a multi-host lab.
SENTINELX_CONTROLLER_PROXY_TARGET=http://127.0.0.1:8000

# Optional Controller URL for Agent enrollment commands.
# When absent, the form uses the dashboard origin and remains editable.
# VITE_AGENT_CONTROLLER_URL=http://192.168.1.10:8000
