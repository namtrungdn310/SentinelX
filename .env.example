# SentinelX Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

SENTINELX_ENV=development
SENTINELX_LOG_LEVEL=INFO

# Controller Settings
SENTINELX_CONTROLLER_HOST=0.0.0.0
SENTINELX_CONTROLLER_PORT=8000

# PostgreSQL Database
SENTINELX_DB_HOST=localhost
SENTINELX_DB_PORT=5432
SENTINELX_DB_USER=sentinelx
SENTINELX_DB_PASSWORD=sentinelx_password
SENTINELX_DB_NAME=sentinelx

# Load Balancer Settings
SENTINELX_LB_HOST=0.0.0.0
SENTINELX_LB_PORT=8080
