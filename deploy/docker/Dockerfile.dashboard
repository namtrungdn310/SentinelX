# SentinelX Dashboard SPA (Vite build + Nginx reverse proxy for REST/WebSocket)
FROM node:22-alpine AS builder
WORKDIR /app/dashboard
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci
COPY dashboard/ ./
RUN npm run build

FROM nginx:1.27-alpine
ENV SENTINELX_CONTROLLER_UPSTREAM=sentinelx_controller:8000
COPY --from=builder /app/dashboard/dist /usr/share/nginx/html
COPY deploy/docker/nginx.dashboard.conf /etc/nginx/templates/default.conf.template
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:80/index.html || exit 1
