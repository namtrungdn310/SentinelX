# Traffic Generator and Attack Simulator Dockerfile
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    hping3 \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

COPY lab/traffic/attack_scenarios.py /app/attack_scenarios.py

# Default: wait for commands or run normal traffic loop
CMD ["python", "attack_scenarios.py", "normal", "--target", "http://sentinelx_lb:8080", "--rate", "1"]
