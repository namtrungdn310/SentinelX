# ==============================================================================
# SentinelX Multi-Host Deployment — Machine A (Control Plane & Gateway)
# Physical / VM IP: e.g. 192.168.1.10
# Services: Controller, PostgreSQL, Dashboard, Load Balancer
# ==============================================================================

# --- Controller Settings ---
SENTINELX_ENVIRONMENT=production
SENTINELX_SERVER__HOST=0.0.0.0
SENTINELX_SERVER__PORT=8000
SENTINELX_DB_HOST=127.0.0.1
SENTINELX_DB_PORT=5432
SENTINELX_DB_USER=sentinelx
SENTINELX_DB_PASSWORD=sentinelx_password
SENTINELX_DB_NAME=sentinelx
SENTINELX_LOGGING__LEVEL=INFO

# --- Load Balancer Settings ---
SENTINELX_LB_HOST=0.0.0.0
SENTINELX_LB_PORT=8080
SENTINELX_LB_ALGORITHM=round_robin
# Remote backends pointing to Machine B and Machine C over LAN:
SENTINELX_LB_BACKENDS=http://192.168.1.20:8080,http://192.168.1.30:8080
SENTINELX_LB_HEALTH_CHECK__ENABLED=true
SENTINELX_LB_HEALTH_CHECK__PATH=/health
SENTINELX_LB_HEALTH_CHECK__INTERVAL_SECONDS=2.0
SENTINELX_LB_HEALTH_CHECK__FAILURE_THRESHOLD=3
SENTINELX_LB_HEALTH_CHECK__SUCCESS_THRESHOLD=2

# --- Dashboard Settings (Vite) ---
# Set VITE_CONTROLLER_URL to Machine A LAN IP for external browser access:
VITE_CONTROLLER_URL=http://192.168.1.10:8000
