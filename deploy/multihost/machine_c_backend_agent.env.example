# ==============================================================================
# SentinelX Multi-Host Deployment — Machine C (Worker Node 02)
# Physical / VM IP: e.g. 192.168.1.30
# Services: Workload Backend02, SentinelX Agent Daemon
# ==============================================================================

# --- Workload Backend Settings ---
NODE_NAME=backend02
PORT=8080

# --- SentinelX Agent Daemon Settings ---
# Outbound connection to Controller on Machine A (LAN IP):
SENTINELX_CONTROLLER_URL=http://192.168.1.10:8000
SENTINELX_NODE_ID=REPLACE_WITH_BACKEND02_NODE_UUID
SENTINELX_ENROLLMENT_TOKEN=REPLACE_WITH_FRESH_ONE_TIME_TOKEN
SENTINELX_HEARTBEAT_INTERVAL=5
SENTINELX_TELEMETRY_INTERVAL=5
SENTINELX_TELEMETRY_COLLECTOR_TYPE=real
SENTINELX_IDENTITY_PATH=data/backend02_identity.json
# Native systemd installation/enrollment: docs/AGENT_INSTALLATION.md.
# Do not retain the token in a permanent service environment after enrollment.
